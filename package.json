{
  "name": "gitbeaker",
  "type": "module",
  "private": true,
  "repository": "github:jdalrymple/gitbeaker",
  "bugs": {
    "url": "https://github.com/jdalrymple/gitbeaker/issues"
  },
  "author": "Justin Dalrymple",
  "scripts": {
    "build": "nx run-many --target=build",
    "lint": "nx run-many --target=lint",
    "lint:fix": "nx run-many --target=lint:fix",
    "clean": "pnpm dlx rimraf --glob '**/{tmp,dist,node_modules,coverage,reports,.nx}'",
    "format:docs": "oxfmt './*.{json,yml,md,mjs,mts,js,ts}' './packages/*/*.{json,yml,md,mjs,mts,js,ts}'",
    "format:src": "oxfmt '**/{src,test,scripts}/**/*.ts'",
    "format": "pnpm format:src --check && pnpm format:docs --check",
    "format:fix": "pnpm format:src --write && pnpm format:docs --write",
    "test:types": "nx run-many --target=test:types",
    "test:unit": "nx run-many --target=test:unit",
    "test:integration": "nx run-many --target=test:integration",
    "test:e2e": "nx run-many --target=test:e2e",
    "test:full": "./scripts/run-full-test-suite.sh",
    "release": "node scripts/auto-release.mjs production",
    "release:canary": "node scripts/auto-release.mjs canary",
    "release:pre": "node scripts/auto-release.mjs pre",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@changesets/config": "^4.0.1",
    "@changesets/get-release-plan": "^5.0.2",
    "@changesets/git": "^4.0.1",
    "@changesets/read": "^1.0.1",
    "@changesets/write": "^1.0.1",
    "@codecov/bundle-analyzer": "^2.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "all-contributors-cli": "^7.0.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nx": "^24.0.5",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
