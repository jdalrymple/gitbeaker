{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "noEmit": true,
    "pretty": true,
    "sourceMap": true,
    "inlineSources": true,
    "allowJs": true,

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "strictPropertyInitialization": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "esModuleInterop": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  }
}
