{
  "name": "@gitbeaker/core",
  "version": "43.8.0",
  "description": "Core API implementation of the GitLab API",
  "license": "MIT",
  "engines": {
    "node": ">=v24.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jdalrymple/gitbeaker",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/jdalrymple/gitbeaker/issues"
  },
  "homepage": "https://github.com/jdalrymple/gitbeaker#readme",
  "author": {
    "name": "Justin Dalrymple"
  },
  "keywords": [
    "gitlab",
    "api",
    "core",
    "gitbeaker"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    "./map.json": "./dist/map.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:self && pnpm run build:map",
    "build:map": "tsx scripts/generate.ts",
    "build:self": "tsdown src/index.ts --format esm --dts --treeshake",
    "test:types": "tsc",
    "test:integration": "vitest run --config vitest.config.mjs test/integration",
    "test:unit": "vitest run --config vitest.config.mjs test/unit",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint src test scripts --fix"
  },
  "dependencies": {
    "@gitbeaker/requester-utils": "^43.8.0",
    "picoquery": "^2.5.0",
    "xcase": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
