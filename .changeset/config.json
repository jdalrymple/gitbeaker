{
  "$schema": "https://unpkg.com/@changesets/config@3.1.2/schema.json",
  "changelog": [
    "./individual-changelog.mjs",
    {
      "repo": "jdalrymple/gitbeaker",
      "template": "- {summary} {ref} ({authors})\n\n",
      "disableThanks": false,
      "global": "./global-changelog.mjs"
    }
  ],
  "commit": false,
  "fixed": [["@gitbeaker/cli", "@gitbeaker/core", "@gitbeaker/requester-utils", "@gitbeaker/rest"]],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": []
}
